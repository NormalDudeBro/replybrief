<Window x:Class="ReplyBrief.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ReplyBrief"
        Width="1160"
        Height="840"
        MinWidth="600"
        MinHeight="560"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        Background="{StaticResource Surface0}"
        Foreground="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource Surface1}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1"
            Padding="28,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel>
          <TextBlock Text="ReplyBrief"
                     FontSize="25"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}" />
          <TextBlock Text="Editorial notes for the conversations that matter."
                     FontSize="13"
                     Foreground="{StaticResource InkMuted}"
                     Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Column="1"
                VerticalAlignment="Center"
                Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="14,6">
          <TextBlock Text="Gmail and Teams planned"
                     FontSize="12"
                     Foreground="{StaticResource TealSoft}" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,6,0">
      <Grid x:Name="LayoutGrid" Margin="28,22,22,26">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" MinWidth="380" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="2*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Conversation -->
        <Border Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Top"
                Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Style="{StaticResource Eyebrow}" Text="CONVERSATION" />
              <StackPanel Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top">
                <Button Content="Load pending capture"
                        Style="{StaticResource QuietAction}"
                        Command="{Binding LoadPendingCommand}"
                        Visibility="{Binding HasPendingCapture, Converter={StaticResource VisibleWhenTrue}}"
                        Margin="0,0,8,0" />
                <Button Content="Clear capture"
                        Style="{StaticResource QuietAction}"
                        Command="{Binding ClearCommand}" />
              </StackPanel>
            </Grid>

            <Border Background="{StaticResource Surface2}"
                    CornerRadius="8"
                    Padding="13,10"
                    Margin="0,10,0,0"
                    Visibility="{Binding HasPendingCapture, Converter={StaticResource VisibleWhenTrue}}">
              <TextBlock Style="{StaticResource Body}"
                         FontSize="12.5"
                         Text="{Binding PendingCaptureNotice}" />
            </Border>

            <TextBlock Style="{StaticResource CardTitle}"
                       Margin="0,10,0,4"
                       Text="What you are answering" />
            <TextBlock Style="{StaticResource Body}"
                       Margin="0,0,0,16"
                       Text="Paste the thread below, or let the local capture host fill it in. Nothing is analyzed until you confirm the server and ask for it." />

            <Border Background="{StaticResource Surface2}"
                    CornerRadius="8"
                    Padding="13,10"
                    Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{Binding OriginLabel}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TealSoft}" />
                <TextBlock Style="{StaticResource Body}"
                           Margin="0,4,0,0"
                           Text="{Binding CoverageNotice}" />
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="SOURCE" />
                <TextBox Style="{StaticResource Field}"
                         Text="{Binding SourceText, Mode=OneWay}"
                         IsReadOnly="True"
                         IsEnabled="{Binding IsCaptureEditable}"
                         Foreground="{StaticResource InkMuted}" />
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="THREAD TITLE" />
                <TextBox Style="{StaticResource Field}"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsCaptureEditable}" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="PARTICIPANTS" />
                <TextBox Style="{StaticResource Field}"
                         Text="{Binding Participants, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsCaptureEditable}" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="CONTEXT ALREADY AVAILABLE" />
                <TextBox Style="{StaticResource Field}"
                         Text="{Binding ContextUsed, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsCaptureEditable}" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,6">
              <TextBlock Style="{StaticResource FieldLabel}" Text="CONVERSATION TEXT" />
              <TextBlock HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         FontSize="11.5"
                         Foreground="{StaticResource InkMuted}"
                         Text="{Binding ContentCountText}" />
            </Grid>

            <Border>
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Setter Property="CornerRadius" Value="7" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsContentOverLimit}" Value="True">
                      <Setter Property="BorderBrush" Value="{StaticResource Bad}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBox Style="{StaticResource Field}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="230"
                       VerticalScrollBarVisibility="Auto"
                       Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding IsCaptureEditable}" />
            </Border>

            <TextBlock Style="{StaticResource Body}"
                       FontSize="12.5"
                       Foreground="{StaticResource InkMuted}"
                       Margin="0,8,0,0"
                       Text="You can edit anything the capture host brought in. The note above keeps saying where the text came from, so a trimmed thread is never passed off as the whole thing." />
          </StackPanel>
        </Border>

        <StackPanel x:Name="SideColumn" Grid.Row="0" Grid.Column="2">
          <!-- Capture host -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="LOCAL CAPTURE HOST" />
              <TextBlock Style="{StaticResource CardTitle}" Margin="0,10,0,4" Text="Pair a source to this window" />
              <TextBlock Style="{StaticResource Body}" Text="{Binding LocalCaptureStatusText}" />
              <TextBlock Style="{StaticResource Body}"
                         FontSize="12"
                         Margin="0,8,0,0"
                         Text="Outlook also requires trusting this machine's HTTPS certificate and installing the add-in. A listening host does not mean the certificate is trusted. See docs/outlook.md; certificate setup requires the .NET SDK." />

              <Border Background="{StaticResource Surface0}"
                      BorderBrush="{StaticResource Line}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="12,9"
                      Margin="0,12,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PAIRING CODE" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding PairingCode}"
                               FontFamily="Consolas"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TealSoft}" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="Copy"
                          Style="{StaticResource QuietAction}"
                          Command="{Binding CopyPairingCommand}" />
                </Grid>
              </Border>

              <TextBlock Text="{Binding PairingNotice}"
                         FontSize="11.5"
                         Foreground="{StaticResource TealSoft}"
                         Margin="0,6,0,0"
                         Visibility="{Binding HasPairingNotice, Converter={StaticResource VisibleWhenTrue}}" />

              <Border Background="{StaticResource Surface2}"
                      CornerRadius="8"
                      Padding="13,10"
                      Margin="0,12,0,0"
                      Visibility="{Binding LocalCaptureHintVisible, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Style="{StaticResource Body}"
                           FontSize="12.5"
                           Text="{Binding LocalCaptureHint}" />
              </Border>
            </StackPanel>
          </Border>

          <!-- Server -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="OLLAMA SERVER" />
              <TextBlock Style="{StaticResource CardTitle}" Margin="0,10,0,4" Text="Who reads the conversation" />
              <TextBlock Style="{StaticResource Body}"
                         Text="The address can be this machine or a server on your network. Whichever you choose receives the conversation as soon as you confirm below." />

              <TextBlock Style="{StaticResource FieldLabel}" Text="SERVER ADDRESS" Margin="0,14,0,5" />
              <TextBox Style="{StaticResource Field}"
                       Text="{Binding OllamaHost, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding IsSettingsEditable}" />
              <TextBlock Style="{StaticResource Body}"
                         FontSize="12"
                         Foreground="{StaticResource InkMuted}"
                         Margin="0,6,0,0"
                         Text="A base address with http or https, ending in the port Ollama listens on. Defaults come from REPLYBRIEF_OLLAMA_URL when it is set." />

              <TextBlock Style="{StaticResource FieldLabel}" Text="MODEL" Margin="0,14,0,5" />
              <TextBox Style="{StaticResource Field}"
                       Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding IsSettingsEditable}" />
              <TextBlock Style="{StaticResource Body}"
                         FontSize="12"
                         Foreground="{StaticResource InkMuted}"
                         Margin="0,6,0,0"
                         Text="Defaults come from REPLYBRIEF_OLLAMA_MODEL when it is set." />

              <StackPanel Margin="0,14,0,0">
                <Button Content="{Binding CheckConnectionLabel}"
                        Style="{StaticResource QuietAction}"
                        HorizontalAlignment="Left"
                        Command="{Binding CheckConnectionCommand}" />
                <TextBlock Style="{StaticResource Body}"
                           FontSize="12.5"
                           Margin="0,10,0,0"
                           Text="{Binding AvailableModelList}"
                           Visibility="{Binding HasAvailableModels, Converter={StaticResource VisibleWhenTrue}}" />
                <TextBlock Style="{StaticResource Body}"
                           FontSize="12"
                           Foreground="{StaticResource InkMuted}"
                           Margin="0,4,0,0"
                           Text="The check only asks the server what models it has. It sends none of the conversation." />
              </StackPanel>

              <Border Background="{StaticResource Surface2}"
                      CornerRadius="8"
                      Padding="13,11"
                      Margin="0,16,0,0">
                <StackPanel>
                  <CheckBox Content="{Binding NetworkConsentText}"
                            IsChecked="{Binding NetworkConsent, Mode=TwoWay}"
                            IsEnabled="{Binding NetworkConsentEnabled}" />
                  <TextBlock Style="{StaticResource Body}"
                             FontSize="12"
                             Foreground="{StaticResource InkMuted}"
                             Margin="0,8,0,0"
                             Text="Required for each analysis, and cleared again whenever the conversation or the address changes." />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Run -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Eyebrow}" Text="RUN" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Analyze conversation"
                        Style="{StaticResource PrimaryAction}"
                        Command="{Binding AnalyzeCommand}" />
                <Button Content="Cancel"
                        Style="{StaticResource QuietAction}"
                        Command="{Binding CancelCommand}"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsAnalyzing, Converter={StaticResource VisibleWhenTrue}}" />
              </StackPanel>

              <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="LineHeight" Value="20" />
                    <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding StatusTone}" Value="busy">
                        <Setter Property="Foreground" Value="{StaticResource TealSoft}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusTone}" Value="success">
                        <Setter Property="Foreground" Value="{StaticResource Good}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding StatusTone}" Value="error">
                        <Setter Property="Foreground" Value="{StaticResource Bad}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <TextBlock Style="{StaticResource Body}"
                         FontSize="12.5"
                         Foreground="{StaticResource InkMuted}"
                         Margin="0,10,0,0"
                         Text="Editing pauses while an analysis runs, and the reading below is cleared the moment the conversation changes or a new run starts, so a summary can never sit beside text it does not describe. Errors say what went wrong without quoting the model or the server." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Reading -->
        <Border x:Name="ReadingCard" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Eyebrow}" Text="READING" />
            <TextBlock Style="{StaticResource CardTitle}" Margin="0,10,0,4" Text="Four sections, in full" />
            <TextBlock Style="{StaticResource Body}"
                       Margin="0,0,0,4"
                       Text="Every bullet comes from the model and only from the text above it. Sections the model had nothing to say about are marked as such rather than filled in." />

            <TextBlock Style="{StaticResource Body}"
                       Foreground="{StaticResource InkMuted}"
                       Margin="0,12,0,0"
                       Text="No analysis yet. Capture a conversation, confirm the server, then run one."
                       Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenFalse}}" />

            <Grid Margin="0,14,0,0"
                  Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenTrue}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource NoteCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="SUMMARY" />
                  <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource Bullet}" />
                  <TextBlock Style="{StaticResource Body}"
                             Foreground="{StaticResource InkMuted}"
                             FontSize="12.5"
                             Text="Nothing to summarize in the text provided."
                             Visibility="{Binding HasSummary, Converter={StaticResource VisibleWhenFalse}}" />
                </StackPanel>
              </Border>

              <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource NoteCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="NEEDS ATTENTION" />
                  <ItemsControl ItemsSource="{Binding NeedsAttention}" ItemTemplate="{StaticResource Bullet}" />
                  <TextBlock Style="{StaticResource Body}"
                             Foreground="{StaticResource InkMuted}"
                             FontSize="12.5"
                             Text="Nothing flagged."
                             Visibility="{Binding HasNeedsAttention, Converter={StaticResource VisibleWhenFalse}}" />
                </StackPanel>
              </Border>

              <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource NoteCard}" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="SUGGESTED REPLY POINTS" />
                  <ItemsControl ItemsSource="{Binding ReplyPoints}" ItemTemplate="{StaticResource Bullet}" />
                  <TextBlock Style="{StaticResource Body}"
                             Foreground="{StaticResource InkMuted}"
                             FontSize="12.5"
                             Text="No points to suggest."
                             Visibility="{Binding HasReplyPoints, Converter={StaticResource VisibleWhenFalse}}" />
                </StackPanel>
              </Border>

              <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource NoteCard}" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource FieldLabel}" Text="MISSING INFORMATION" />
                  <ItemsControl ItemsSource="{Binding MissingInformation}" ItemTemplate="{StaticResource Bullet}" />
                  <TextBlock Style="{StaticResource Body}"
                             Foreground="{StaticResource InkMuted}"
                             FontSize="12.5"
                             Text="Nothing missing that the text made obvious."
                             Visibility="{Binding HasMissingInformation, Converter={StaticResource VisibleWhenFalse}}" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
