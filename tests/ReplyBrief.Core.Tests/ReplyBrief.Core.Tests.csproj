<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ReplyBrief.Core.Tests</RootNamespace>
    <AssemblyName>ReplyBrief.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReplyBrief.Core\ReplyBrief.Core.csproj" />
  </ItemGroup>

  <!-- Kestrel hosts the fake Ollama API, so the analyzer is exercised over a real socket with real
       HTTP framing, chunked bodies, redirect handling and cancellation rather than a stubbed
       transport that would have to reimplement those behaviours. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>